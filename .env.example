# Copy to .env (git-ignored) and edit. The binary never reads this file itself:
# the ./dev wrapper sources .env and passes the values on as environment
# variables, e.g. `./dev go run ./cmd/organizer`. Every value below is the
# default, so an untouched copy behaves exactly like no .env at all.
#
# The README's configuration table is the reference for these.

# TCP address the HTTP server listens on.
ORGANIZER_ADDR=:8080

# Path to the SQLite database file, for the server and every subcommand.
ORGANIZER_DB_PATH=organizer.db

# Absolute cap on a trainer session, counted from login. Go duration syntax.
ORGANIZER_SESSION_LIFETIME=720h

# Expires a session that goes unused for this long, inside the lifetime above.
ORGANIZER_SESSION_IDLE_TIMEOUT=168h

# Mark session cookies Secure (HTTPS only). False locally, or the browser drops
# the cookie over plain HTTP.
ORGANIZER_SECURE=false
